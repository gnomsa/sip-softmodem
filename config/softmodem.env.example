SOFTMODEM_BIND_IP=0.0.0.0
SOFTMODEM_PUBLIC_IP=192.0.2.20
SOFTMODEM_SIP_PORT=5060
SOFTMODEM_RTP_PORT=10000
# ALL means every protocol implemented by the installed build.
SOFTMODEM_PROTOCOLS=ALL
SOFTMODEM_MAX_RATE=33600
SOFTMODEM_ALLOWED_IPS=192.0.2.10
# SIP proxy/SBC used by ATDT, ATDP and ATDL. Empty disables outgoing calls.
SOFTMODEM_OUTBOUND_HOST=192.0.2.10
SOFTMODEM_OUTBOUND_PORT=5060
SOFTMODEM_TTY=/run/sip-softmodem/ttyMODEM0
SOFTMODEM_USER_AGENT=My-Lab-Modem/0.1
SOFTMODEM_SDP_ORIGIN=labmodem
SOFTMODEM_SDP_NAME=Laboratory SIP Modem
